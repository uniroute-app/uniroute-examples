{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "uniroute-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "UniRoute",
      "options": {
        "baseURL": "https://api.uniroute.app/v1",
        "apiKey": "YOUR_UNIROUTE_API_KEY"
      },
      "models": {
        "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5" },
        "claude-fable-5-2": { "name": "Claude Fable 5.2" }
      }
    }
  },
  "model": "uniroute-anthropic/claude-sonnet-5-5"
}
